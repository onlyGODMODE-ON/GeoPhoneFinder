# Copy to .env (or export these variables). Every value is optional in development.

# --- Server ---
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
# Public site URL: used for canonical links, sitemap.xml and robots.txt
SITE_URL=http://localhost:3001
# Comma-separated list of allowed browser origins (leave empty in dev; the Vite proxy needs none)
CORS_ORIGIN=
RATE_LIMIT_MAX=240
CATALOG_CACHE_SECONDS=60

# --- Database ---
# Empty => embedded PGlite (real Postgres compiled to WASM, in-memory). Great for local dev.
# Set to a PostgreSQL URL for anything else, e.g. the one from docker-compose.yml:
DATABASE_URL=
# PGSSL=require        # for managed databases that need TLS
# PGLITE_DIR=./.pglite # persist the embedded DB to disk

# --- Data collection ---
# demo = bundled ILLUSTRATIVE sample data. live = real retailer adapters (see docs/ADAPTERS.md)
ADAPTER_MODE=demo
INGEST_ON_START=true
RUN_SCHEDULER=true
INGEST_INTERVAL_MINUTES=60
# An offer older than this is "stale" and never drives a recommendation
STALE_AFTER_HOURS=48
RECENTLY_UPDATED_HOURS=6
# Live feeds (only used when ADAPTER_MODE=live), one per store id:
# FEED_URL_ZOOMMER=https://...
# FEED_URL_ALTA=https://...
# FEED_URL_XIAOMI=https://...

# --- Operations ---
# Enables POST /api/admin/ingest (header: x-admin-token). Leave empty to disable the endpoint.
ADMIN_TOKEN=
